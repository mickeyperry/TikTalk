<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.mickeyperry.tiktalk"
    ExtensionBundleVersion="2.1.0" ExtensionBundleName="TikTalk"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.mickeyperry.tiktalk" Version="2.1.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- AEFT = After Effects. Range covers CC 2019 (16.0) through future builds. -->
            <Host Name="AEFT" Version="[16.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.mickeyperry.tiktalk">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--allow-file-access</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>TikTalk</Menu>
                    <Geometry>
                        <Size>
                            <Height>700</Height>
                            <Width>360</Width>
                        </Size>
                        <MinSize>
                            <Height>300</Height>
                            <Width>280</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>1600</Height>
                            <Width>800</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons />
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
